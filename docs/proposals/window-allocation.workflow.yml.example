# INACTIVE. Read one terminal cancelled job; leave the native rerun untouched.
name: Temporary Framelet executor diagnostic
on:
  push:
    branches: [qa/framelet-window-allocation-20261112]
    paths: [.github/workflows/framelet-window-allocation-20261112.yml]
permissions:
  contents: write
  actions: write
  checks: read
jobs:
  diagnose:
    if: github.repository == 'alvarovillalbaa/framelet' && github.event.repository.private == false && github.ref == 'refs/heads/qa/framelet-window-allocation-20261112'
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: REVIEWED_SOURCE_SHA
          persist-credentials: false
          clean: false
      - name: Read the old check annotation and retire only this diagnostic control
        env:
          GH_TOKEN: ${{ github.token }}
        run: python3 -I -B -S Tests/ci/inspect-window-allocation.py
