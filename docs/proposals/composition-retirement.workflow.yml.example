# INACTIVE. Replace only REVIEWED_SOURCE_SHA.
name: Temporary Framelet composition control closeout
on:
  push:
    branches: [qa/framelet-composition-retirement-20261112-1]
    paths: [.github/workflows/framelet-composition-retirement-20261112-1.yml]
permissions:
  contents: write
  actions: write
concurrency:
  group: framelet-composition-retirement-20261112
  cancel-in-progress: false
jobs:
  closeout:
    if: github.repository == 'alvarovillalbaa/framelet' && github.event.repository.private == false && github.ref == 'refs/heads/qa/framelet-composition-retirement-20261112-1'
    runs-on: ubuntu-24.04
    timeout-minutes: 3
    env:
      FRAMELET_SOURCE_COMMIT: REVIEWED_SOURCE_SHA
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: REVIEWED_SOURCE_SHA
          fetch-depth: 1
          persist-credentials: false
          clean: false
      - name: Verify artifact and retire exact controls without app execution
        timeout-minutes: 2
        env:
          GH_TOKEN: ${{ github.token }}
        run: python3 -I -B -S Tests/ci/close-composition-probe.py
