# INACTIVE. Only after the exact first native attempt is terminal/unallocated.
name: Temporary Framelet unallocated picker retirement
on:
  push:
    branches: [qa/framelet-picker-allocation-20261112]
    paths: [.github/workflows/framelet-picker-allocation-20261112.yml]
permissions:
  contents: write
  actions: write
  checks: read
jobs:
  diagnose:
    if: github.repository == 'alvarovillalbaa/framelet' && github.event.repository.private == false && github.ref == 'refs/heads/qa/framelet-picker-allocation-20261112'
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: REVIEWED_SOURCE_SHA
          persist-credentials: false
          clean: false
      - name: Diagnose and retire only the unallocated candidate and this control
        env:
          GH_TOKEN: ${{ github.token }}
        run: python3 -I -B -S Tests/ci/retire-unallocated-picker.py
