# INACTIVE. Activate only on the exact QA branch with immutable SOURCE_COMMIT.
name: Temporary Framelet native editor acceptance
on:
  push:
    branches: [qa/framelet-ui-20261112-1]
    paths: [.github/workflows/framelet-ui-20261112-1.yml]
permissions:
  contents: write
  actions: write
concurrency:
  group: framelet-ui-20261112
  cancel-in-progress: false
jobs:
  acceptance:
    if: github.repository == 'alvarovillalbaa/framelet' && github.event.repository.private == false && github.ref == 'refs/heads/qa/framelet-ui-20261112-1'
    runs-on: macos-15
    timeout-minutes: 20
    env:
      FRAMELET_SOURCE_COMMIT: SOURCE_COMMIT
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: SOURCE_COMMIT
          persist-credentials: false
          clean: false
      - name: Run only the authored native editor journey
        timeout-minutes: 17
        run: python3 -I -B -S Tests/ci/run-ui-acceptance.py
      - name: Admit bounded evidence
        if: always()
        id: evidence
        env:
          PACKET: ${{ runner.temp }}/framelet-ui-evidence-${{ github.run_id }}
        run: |
          python3 -I -B -S - <<'PY'
          import os
          from pathlib import Path
          root = Path(os.environ['PACKET'])
          paths = list(root.rglob('*')) if root.is_dir() and not root.is_symlink() else []
          files = [p for p in paths if p.is_file()]
          size = sum(p.stat().st_size for p in files)
          admitted = bool(files) and len(paths) <= 8192 and size <= 128*1024**2 and all(not p.is_symlink() for p in paths)
          with open(os.environ['GITHUB_OUTPUT'], 'a') as output: output.write(f'admitted={str(admitted).lower()}\n')
          print(f'{len(files)} files, {size} bytes, admitted={admitted}')
          raise SystemExit(0 if admitted else 1)
          PY
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: always() && steps.evidence.outputs.admitted == 'true'
        id: upload
        with:
          name: framelet-native-ui-${{ github.run_id }}
          path: ${{ runner.temp }}/framelet-ui-evidence-${{ github.run_id }}
          retention-days: 2
          if-no-files-found: error
      - name: Retire exact temporary controls and uploaded scratch
        if: always()
        env:
          GH_TOKEN: ${{ github.token }}
          FRAMELET_ARTIFACT_ID: ${{ steps.upload.outputs.artifact-id }}
          FRAMELET_ARTIFACT_DIGEST: ${{ steps.upload.outputs.artifact-digest }}
        run: python3 -I -B -S Tests/ci/retire-ui-acceptance.py
