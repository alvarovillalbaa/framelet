# INACTIVE. Requires explicit ordered-playback native checks and temporary-CI approval.
# Activate only on qa/ordered-playback; remove the active workflow after checks.
name: Temporary Framelet ordered playback acceptance
on:
  push:
    branches: [qa/ordered-playback]
    paths: [.github/workflows/ordered-playback.yml]
permissions:
  contents: read
jobs:
  playback:
    if: github.repository == 'alvarovillalbaa/framelet' && github.event.repository.private == false && github.ref == 'refs/heads/qa/ordered-playback'
    runs-on: macos-15
    timeout-minutes: 20
    env:
      CI: "true"
      DO_NOT_TRACK: "1"
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          persist-credentials: false
      - name: Verify source, toolchain and exact disposable ownership
        id: preflight
        run: |
          git rev-parse HEAD
          swift --version
          xcrun --sdk macosx --show-sdk-version
          python3 <<'PY'
          import hashlib, json, os, pathlib, re, subprocess
          if subprocess.check_output(['uname', '-m'], text=True).strip() != 'arm64':
              raise SystemExit('Re-review the changed standard runner architecture.')
          sdk = subprocess.check_output(['xcrun', '--sdk', 'macosx', '--show-sdk-version'], text=True).strip()
          if int(sdk.split('.')[0]) < 15:
              raise SystemExit('SDK 15 or later is required.')
          seal = json.loads(pathlib.Path('docs/results/2026/10-28/ordered-playback-source.json').read_text())
          for name, expected in seal['sha256'].items():
              source = pathlib.Path(name)
              if source.is_absolute() or '..' in source.parts or source.is_symlink():
                  raise SystemExit('Unsafe source identity.')
              if hashlib.sha256(source.read_bytes()).hexdigest() != expected:
                  raise SystemExit('Reviewed source changed: ' + name)
          inputs = ['Package.swift', '.codex/environments/environment.toml']
          for directory in ('Sources', 'Tests', 'Resources', 'script'):
              inputs.extend(path.as_posix() for path in pathlib.Path(directory).rglob('*') if path.is_file())
          if sorted(inputs) != seal['buildInputs']:
              raise SystemExit('The reviewed build-input inventory changed.')
          if '.package(' in pathlib.Path('Package.swift').read_text():
              raise SystemExit('New external dependencies require re-review.')
          actual = {}
          for source in pathlib.Path('Tests').rglob('*.swift'):
              names = re.findall(r'func (test\w+)\(', source.read_text())
              if names:
                  actual[source.as_posix()] = names
          if actual != seal['authoredCases'] or sum(map(len, actual.values())) != 30:
              raise SystemExit('The exact thirty-case scope changed.')
          parent = pathlib.Path(os.environ['RUNNER_TEMP']).resolve()
          if not re.fullmatch(r'[0-9]{1,24}', os.environ['GITHUB_RUN_ID']) or any(c in str(parent) for c in '\r\n'):
              raise SystemExit('Unexpected runner identity.')
          target = parent / ('framelet-playback-' + os.environ['GITHUB_RUN_ID'])
          if target.parent != parent or target.name != 'framelet-playback-' + os.environ['GITHUB_RUN_ID']:
              raise SystemExit('Unexpected fixture ownership.')
          report = parent / 'framelet-ordered-playback.xml'
          if target.exists() or target.is_symlink() or report.exists() or report.is_symlink():
              raise SystemExit('Refusing pre-existing output.')
          if any(pathlib.Path(name).exists() or pathlib.Path(name).is_symlink() for name in ('.build', '.swiftpm', 'dist')):
              raise SystemExit('Refusing pre-existing build output.')
          with open(os.environ['GITHUB_ENV'], 'a') as environment:
              environment.write('FRAMELET_PLAYBACK_ROOT=' + str(target) + '\n')
          target.mkdir(mode=0o700)
          PY
      - name: Compile and package without launching
        run: ./script/build_and_run.sh --build-only
      - name: Run exactly thirty core and synthetic-media cases
        run: |
          swift test --parallel --num-workers 1 --enable-xctest --disable-swift-testing --filter 'Recording(Timeline|Completion|Composition)Tests|UIPlaybackModelTests' --xunit-output "$RUNNER_TEMP/framelet-ordered-playback.xml"
          python3 <<'PY'
          import hashlib, json, os, pathlib, xml.etree.ElementTree as ET
          seal = json.loads(pathlib.Path('docs/results/2026/10-28/ordered-playback-source.json').read_text())
          expected = {(pathlib.Path(file).stem, name) for file, names in seal['authoredCases'].items() for name in names}
          report = pathlib.Path(os.environ['RUNNER_TEMP']) / 'framelet-ordered-playback.xml'
          data = report.read_bytes()
          if not data or len(data) > 1024 * 1024 or report.is_symlink():
              raise SystemExit('Unexpected native report size or type.')
          root = ET.fromstring(data)
          cases = list(root.iter('testcase'))
          actual = [(case.get('classname', '').split('.')[-1], case.get('name', '').removesuffix('()')) for case in cases]
          if len(cases) != 30 or len(set(actual)) != 30 or set(actual) != expected:
              raise SystemExit('The native runner did not execute the exact thirty cases.')
          if any(case.find(tag) is not None for case in cases for tag in ('failure', 'error', 'skipped')):
              raise SystemExit('A selected case failed, errored or skipped.')
          print(json.dumps({'kind': 'framelet-native-acceptance', 'cases': [
              {'class': cls, 'name': name, 'status': 'passed'} for cls, name in sorted(actual)],
              'total': len(cases), 'failures': 0, 'errors': 0, 'skips': 0,
              'xunitBytes': len(data), 'xunitSha256': hashlib.sha256(data).hexdigest()}))
          print('Thirty exact authored cases passed; no app, UI, device or capture was launched.')
          PY
      - name: Verify package metadata, signature and unchanged source
        run: |
          plutil -lint dist/Framelet.app/Contents/Info.plist
          codesign --verify --strict dist/Framelet.app
          test -x dist/Framelet.app/Contents/MacOS/Framelet
          git diff --exit-code -- Package.swift Sources Tests Resources script
      - name: Remove only owned disposable outputs
        if: always() && steps.preflight.outcome == 'success'
        run: |
          python3 <<'PY'
          import os, pathlib, shutil
          workspace = pathlib.Path(os.environ['GITHUB_WORKSPACE']).resolve()
          if pathlib.Path.cwd().resolve() != workspace or workspace.name != 'framelet':
              raise SystemExit('Unexpected checkout; refusing cleanup.')
          for name in ('.build', '.swiftpm', 'dist'):
              target = workspace / name
              if target.is_symlink():
                  raise SystemExit('Refusing a symlinked task output.')
              if target.is_dir():
                  shutil.rmtree(target)
          parent = pathlib.Path(os.environ['RUNNER_TEMP']).resolve()
          root = pathlib.Path(os.environ['FRAMELET_PLAYBACK_ROOT'])
          if root.parent != parent or root.name != 'framelet-playback-' + os.environ['GITHUB_RUN_ID'] or root.is_symlink():
              raise SystemExit('Unexpected fixture ownership; refusing cleanup.')
          if root.is_dir():
              shutil.rmtree(root)
          report = parent / 'framelet-ordered-playback.xml'
          if report.is_symlink():
              raise SystemExit('Refusing a symlinked test report.')
          if report.is_file():
              report.unlink()
          print('Owned synthetic media, build and report outputs removed.')
          PY
