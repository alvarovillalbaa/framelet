# INACTIVE. Replace REVIEWED_SOURCE_SHA only after exact scope review.
name: Temporary Framelet failed packet preservation and control closeout
on:
  push:
    branches: [qa/framelet-compatible-closeout-20261112-1]
    paths: [.github/workflows/framelet-compatible-closeout-20261112-1.yml]
permissions:
  contents: write
  actions: write
concurrency:
  group: framelet-compatible-closeout-20261112
  cancel-in-progress: false
jobs:
  close:
    if: github.repository == 'alvarovillalbaa/framelet' && github.event.repository.private == false && github.ref == 'refs/heads/qa/framelet-compatible-closeout-20261112-1'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    env:
      FRAMELET_SOURCE_COMMIT: REVIEWED_SOURCE_SHA
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: REVIEWED_SOURCE_SHA
          fetch-depth: 1
          persist-credentials: false
          clean: false
      - name: Preserve one failed raw packet and retire exact controls
        env:
          GH_TOKEN: ${{ github.token }}
        run: python3 -I -B -S Tests/ci/close-compatible-playback.py
