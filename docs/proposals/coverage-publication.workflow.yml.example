# INACTIVE. Replace REVIEWED_SOURCE_SHA only after exact source review.
name: Temporary Framelet 0.1.5 exact-asset publication
on:
  push:
    branches: [qa/framelet-coverage-publish-20261112-1]
    paths: [.github/workflows/framelet-coverage-publish-20261112-1.yml]
permissions:
  contents: write
  actions: write
concurrency:
  group: framelet-coverage-publish-20261112
  cancel-in-progress: false
jobs:
  publication:
    if: github.repository == 'alvarovillalbaa/framelet' && github.event.repository.private == false && github.ref == 'refs/heads/qa/framelet-coverage-publish-20261112-1'
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    env:
      FRAMELET_SOURCE_COMMIT: REVIEWED_SOURCE_SHA
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: REVIEWED_SOURCE_SHA
          fetch-depth: 1
          persist-credentials: false
          clean: false
      - name: Publish only retained assets and verified playback record
        timeout-minutes: 8
        env:
          GH_TOKEN: ${{ github.token }}
        run: python3 -I -B -S Tests/ci/publish-coverage-preview.py
